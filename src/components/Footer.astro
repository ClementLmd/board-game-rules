---
const currentYear = new Date().getFullYear();
---

<footer class="bg-white border-t border-gray-100 mt-12">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-between sm:items-center">
      <a href="/" class="flex items-center gap-2">
        <span class="text-xl">🎲</span>
        <span class="font-bold text-gray-900">Règles du Jeu</span>
      </a>
      <nav aria-label="Pied de page" class="flex flex-wrap items-center justify-center gap-x-6 gap-y-1 text-sm text-gray-500">
        <a href="/" class="hover:text-primary-600 transition-colors">Accueil</a>
        <a href="/jeux/" class="hover:text-primary-600 transition-colors">Jeux</a>
        <a href="/a-propos/" class="hover:text-primary-600 transition-colors">À propos</a>
      </nav>
    </div>
    <p class="mt-4 text-center text-xs text-gray-400 sm:text-left">
      &copy; {currentYear} Règles du Jeu
    </p>
  </div>
</footer>
