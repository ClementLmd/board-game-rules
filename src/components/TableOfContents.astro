---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  gameSlug?: string;
}

const { headings, gameSlug = '' } = Astro.props;

// Only show H2 headings for the TOC
const tocItems = headings.filter((h) => h.depth === 2);

// Find the advice heading slug (for the floating button on mobile)
const adviceHeading = tocItems.find(
  (h) => h.text.toLowerCase().includes('conseil') || h.text.toLowerCase().includes('stratégie')
);
---

{tocItems.length > 0 && (
  <>
    {/* ─── Mobile: Conseils above summary (when not loup-garou, which has it next to CTA) ─── */}
    {adviceHeading && gameSlug !== 'loup-garou' && (
      <div class="lg:hidden mb-3">
        <a
          href={`#${adviceHeading.slug}`}
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-gray-200 bg-white text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 active:bg-gray-100 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700"
          aria-label="Aller aux conseils"
        >
          <svg class="w-4 h-4 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
          </svg>
          Conseils
        </a>
      </div>
    )}

    {/* ─── Mobile: collapsible card above content ─── */}
    <nav id="toc-mobile" class="lg:hidden mb-8 bg-white rounded-xl border border-gray-100 overflow-hidden">
      <button
        id="toc-toggle"
        class="w-full flex items-center justify-between px-5 py-4 text-left"
        aria-expanded="false"
      >
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h7" />
          </svg>
          <span class="font-semibold text-gray-900 text-sm">Sommaire</span>
          <span class="text-xs text-gray-400">({tocItems.length})</span>
        </div>
        <svg id="toc-chevron" class="w-4 h-4 text-gray-400 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </button>

      <ul id="toc-list-mobile" class="hidden border-t border-gray-50 px-5 py-3 space-y-0.5">
        {tocItems.map((item) => {
          const isAdvice = item.text.toLowerCase().includes('conseil') || item.text.toLowerCase().includes('stratégie');
          return (
            <li>
              <a
                href={`#${item.slug}`}
                class:list={[
                  'toc-link flex items-center gap-2 px-3 py-1.5 rounded-lg text-sm transition-colors',
                  isAdvice
                    ? 'text-primary-600 font-medium hover:bg-primary-50'
                    : 'text-gray-500 hover:text-gray-900 hover:bg-gray-50',
                ]}
                data-slug={item.slug}
              >
                {isAdvice && (
                  <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                  </svg>
                )}
                {item.text}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    {/* ─── Desktop: sticky sidebar ─── */}
    <nav id="toc-desktop" class="hidden lg:block">
      <div class="sticky top-24">
        <div class="flex items-center gap-2 mb-3 px-1">
          <svg class="w-4 h-4 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h7" />
          </svg>
          <span class="font-semibold text-gray-900 text-sm">Sommaire</span>
        </div>

        <ul class="space-y-0.5 border-l-2 border-gray-100">
          {tocItems.map((item) => {
            const isAdvice = item.text.toLowerCase().includes('conseil') || item.text.toLowerCase().includes('stratégie');
            return (
              <li>
                <a
                  href={`#${item.slug}`}
                  class:list={[
                    'toc-link flex items-center gap-2 pl-4 pr-3 py-1.5 -ml-px border-l-2 text-sm transition-all',
                    isAdvice
                      ? 'text-primary-600 font-medium border-transparent hover:border-primary-300 hover:bg-primary-50/50'
                      : 'text-gray-400 border-transparent hover:text-gray-700 hover:border-gray-300',
                  ]}
                  data-slug={item.slug}
                >
                  {isAdvice && (
                    <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                    </svg>
                  )}
                  {item.text}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </nav>

    {/* ─── Floating go-to-top button (mobile only, when scrolled) ─── */}
    <button
      type="button"
      id="floating-goto-top-btn"
      class="lg:hidden fixed bottom-6 right-6 z-40 flex items-center gap-2 px-4 py-2.5 rounded-full bg-primary-600 text-white text-sm font-medium shadow-lg shadow-primary-600/25 hover:bg-primary-700 transition-all opacity-0 translate-y-4 pointer-events-none"
      aria-label="Retour en haut de la page"
      title="Retour en haut"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
      </svg>
      Retour en haut
    </button>
  </>
)}

<script>
  // Mobile TOC toggle
  const toggle = document.getElementById('toc-toggle');
  const listMobile = document.getElementById('toc-list-mobile');
  const chevron = document.getElementById('toc-chevron');

  toggle?.addEventListener('click', () => {
    const isHidden = listMobile?.classList.toggle('hidden');
    chevron?.classList.toggle('rotate-180', !isHidden);
    toggle.setAttribute('aria-expanded', String(!isHidden));
  });

  // Close mobile TOC when clicking a link
  listMobile?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      listMobile.classList.add('hidden');
      chevron?.classList.remove('rotate-180');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });

  // Floating go-to-top button visibility (mobile only): show when TOC has scrolled out of view
  const floatingBtn = document.getElementById('floating-goto-top-btn');
  const tocMobile = document.getElementById('toc-mobile');

  if (floatingBtn && tocMobile) {
    const tocObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.target === tocMobile) {
            const show = !entry.isIntersecting;
            floatingBtn.classList.toggle('opacity-0', !show);
            floatingBtn.classList.toggle('translate-y-4', !show);
            floatingBtn.classList.toggle('pointer-events-none', !show);
            floatingBtn.classList.toggle('opacity-100', show);
            floatingBtn.classList.toggle('translate-y-0', show);
            floatingBtn.classList.toggle('pointer-events-auto', show);
          }
        });
      },
      { threshold: 0 }
    );
    tocObserver.observe(tocMobile);

    floatingBtn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  // Active section highlighting (both mobile + desktop TOC links)
  const tocLinks = document.querySelectorAll('.toc-link') as NodeListOf<HTMLAnchorElement>;
  const slugs = [...new Set(Array.from(tocLinks).map((l) => l.dataset.slug).filter(Boolean))] as string[];
  const headingEls = slugs.map((s) => document.getElementById(s)).filter(Boolean) as HTMLElement[];

  if (headingEls.length > 0) {
    const headingObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            tocLinks.forEach((link) => {
              const isActive = link.dataset.slug === id;
              // Desktop sidebar: active border + text color
              if (link.closest('#toc-desktop')) {
                link.classList.toggle('border-primary-500', isActive);
                link.classList.toggle('text-primary-700', isActive);
                link.classList.toggle('font-medium', isActive);
                link.classList.toggle('border-transparent', !isActive);
              }
              // Mobile: active bg
              if (link.closest('#toc-mobile')) {
                link.classList.toggle('bg-primary-50', isActive);
                link.classList.toggle('text-primary-700', isActive);
                link.classList.toggle('font-medium', isActive);
              }
            });
          }
        });
      },
      { rootMargin: '-80px 0px -60% 0px', threshold: 0 }
    );

    headingEls.forEach((el) => headingObserver.observe(el));
  }
</script>
