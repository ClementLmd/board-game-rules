---
import UserMenu from './competitions/UserMenu';

interface Props {
  dark?: boolean;
}
const { dark = false } = Astro.props;

const navLinks = [
  { href: '/', label: 'Accueil' },
  { href: '/jeux/', label: 'Tous les jeux' },
  { href: '/competitions/', label: 'Compétitions' },
  { href: '/a-propos/', label: 'A propos' },
];

const currentPath = Astro.url.pathname;
const user = Astro.locals.user ?? null;

let profile = null;
let unreadCount = 0;

if (user && Astro.locals.supabase) {
  try {
    const supabase = Astro.locals.supabase;
    const [profileRes, notifRes] = await Promise.all([
      supabase.from('profiles').select('username, avatar_url').eq('id', user.id).single(),
      supabase.from('notifications').select('id', { count: 'exact', head: true }).eq('user_id', user.id).eq('read', false),
    ]);
    profile = profileRes.data;
    unreadCount = notifRes.count ?? 0;
  } catch {
    // graceful fallback
  }
}

const headerClass = dark
  ? 'bg-gray-950/95 backdrop-blur-md border-b border-gray-800 sticky top-0 z-50'
  : 'bg-white/80 backdrop-blur-md border-b border-gray-100 sticky top-0 z-50';

const logoTextClass = dark
  ? 'font-bold text-lg text-gray-100 group-hover:text-violet-400 transition-colors'
  : 'font-bold text-lg text-gray-900 group-hover:text-primary-600 transition-colors';

const linkActive = dark ? 'bg-gray-800 text-gray-100' : 'bg-primary-50 text-primary-700';
const linkIdle = dark
  ? 'text-gray-400 hover:text-gray-100 hover:bg-gray-800'
  : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50';
const mobileButtonClass = dark
  ? 'md:hidden p-2 rounded-lg text-gray-400 hover:bg-gray-800 transition-colors'
  : 'md:hidden p-2 rounded-lg text-gray-600 hover:bg-gray-100 transition-colors';
---

<header class={headerClass} role="banner">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 group">
        <span class="text-2xl">🎲</span>
        <span class={logoTextClass}>Règles du Jeu</span>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-1" aria-label="Navigation principale">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'px-4 py-2 rounded-lg text-sm font-medium transition-colors',
              currentPath === link.href ? linkActive : linkIdle,
            ]}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Auth -->
      <div class="hidden md:flex items-center gap-2">
        {user && profile ? (
          <UserMenu
            client:load
            username={profile.username}
            avatarUrl={profile.avatar_url}
            unreadCount={unreadCount}
            userId={user.id}
          />
        ) : user ? (
          <UserMenu
            client:load
            username={null}
            avatarUrl={null}
            unreadCount={unreadCount}
            userId={user.id}
          />
        ) : (
          <a
            href="/auth/login"
            class:list={[
              'px-4 py-2 rounded-lg text-sm font-medium transition-colors',
              dark
                ? 'bg-violet-700 text-white hover:bg-violet-600'
                : 'bg-violet-600 text-white hover:bg-violet-700',
            ]}
          >
            Connexion
          </a>
        )}
      </div>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        class={mobileButtonClass}
        aria-label="Ouvrir le menu"
        aria-expanded="false"
      >
        <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Mobile Nav -->
    <nav id="mobile-menu" class="md:hidden hidden pb-4" aria-label="Navigation principale (mobile)">
      <div class="flex flex-col gap-1">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'px-4 py-2.5 rounded-lg text-sm font-medium transition-colors',
              currentPath === link.href ? linkActive : linkIdle,
            ]}
          >
            {link.label}
          </a>
        ))}
        <div class="border-t border-gray-100 mt-2 pt-2">
          {user ? (
            <a
              href="/profile/"
              class:list={['px-4 py-2.5 rounded-lg text-sm font-medium transition-colors', linkIdle]}
            >
              Mon profil {unreadCount > 0 && <span class="ml-1 bg-red-500 text-white text-[10px] px-1.5 py-0.5 rounded-full font-bold">{unreadCount}</span>}
            </a>
          ) : (
            <a
              href="/auth/login"
              class:list={['px-4 py-2.5 rounded-lg text-sm font-medium transition-colors bg-violet-600 text-white', '']}
            >
              Connexion
            </a>
          )}
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    iconOpen?.classList.toggle('hidden', isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
    btn.setAttribute('aria-expanded', String(isOpen));
  });
</script>
