---
import BaseLayout from '../layouts/BaseLayout.astro';
import GameCard from '../components/GameCard.astro';
import SearchBar from '../components/SearchBar.astro';
import { getCollection } from 'astro:content';

const allGames = await getCollection('games');
const featuredGames = allGames.slice(0, 6);

// Collect unique categories
const allCategories = [...new Set(allGames.flatMap((game) => game.data.categories))].sort();
---

<BaseLayout title="Règles du Jeu - Règles de jeux de société en français">
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-primary-600 via-primary-700 to-primary-900 text-white">
    <div class="absolute inset-0 overflow-hidden opacity-10 pointer-events-none">
      <div class="absolute top-10 left-10 text-8xl">🎲</div>
      <div class="absolute top-20 right-20 text-6xl">♟️</div>
      <div class="absolute bottom-10 left-1/3 text-7xl">🃏</div>
      <div class="absolute bottom-20 right-10 text-5xl">🎯</div>
    </div>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 pb-28 sm:pb-32 relative">
      <div class="max-w-2xl mx-auto text-center">
        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-4">
          Les règles de vos jeux
          <span class="block text-primary-200">expliquées simplement</span>
        </h1>
        <p class="text-lg sm:text-xl text-primary-100 mb-8 leading-relaxed">
          Retrouvez les règles de vos jeux de société préférés, résumées en français clair et accessible.
        </p>

        <!-- Search -->
        <SearchBar />
      </div>
    </div>
  </section>

  <!-- Featured Games -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900">Jeux populaires</h2>
        <p class="text-gray-500 mt-1">Les règles les plus consultées</p>
      </div>
      <a href="/jeux/" class="btn-secondary hidden sm:inline-flex">
        Voir tous les jeux
        <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {featuredGames.map((game) => (
        <GameCard
          title={game.data.title}
          slug={game.data.slug}
          description={game.data.description}
          players={game.data.players}
          duration={game.data.duration}
          age={game.data.age}
          categories={game.data.categories}
          difficulty={game.data.difficulty}
          image={game.data.image}
        />
      ))}
    </div>

    <div class="mt-8 text-center sm:hidden">
      <a href="/jeux/" class="btn-primary">
        Voir tous les jeux
        <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </section>

  <!-- Categories -->
  <section class="bg-white py-12 sm:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900">Parcourir par catégorie</h2>
        <p class="text-gray-500 mt-1">Trouvez des jeux selon vos envies</p>
      </div>

      <div class="flex flex-wrap justify-center gap-3">
        {allCategories.map((category) => (
          <a
            href={`/categories/${category}/`}
            class="px-4 py-2 rounded-full bg-primary-50 text-primary-700 font-medium text-sm hover:bg-primary-100 transition-colors capitalize"
          >
            {category}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="bg-gradient-to-r from-primary-50 to-primary-100 rounded-2xl p-8 sm:p-12 text-center">
      <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-3">
        Vous ne trouvez pas votre jeu ?
      </h2>
      <p class="text-gray-600 mb-6 max-w-lg mx-auto">
        Nous ajoutons régulièrement de nouvelles règles. Consultez tous les jeux disponibles ou revenez bientôt.
      </p>
      <a href="/jeux/" class="btn-primary">
        Explorer tous les jeux
      </a>
    </div>
  </section>
</BaseLayout>
