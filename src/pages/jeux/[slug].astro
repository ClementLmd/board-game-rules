---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const games = await getCollection('games');
  return games.map((game) => ({
    params: { slug: game.data.slug },
    props: { game },
  }));
}

const { game } = Astro.props;
const { Content, headings } = await render(game);

const { title, description, players, duration, age, categories, difficulty, officialRulesUrl } = game.data;

const difficultyLabels: Record<string, string> = {
  facile: 'Facile',
  moyen: 'Moyen',
  difficile: 'Difficile',
};

const difficultyColors: Record<string, string> = {
  facile: 'bg-green-50 text-green-700',
  moyen: 'bg-amber-50 text-amber-700',
  difficile: 'bg-red-50 text-red-700',
};

const playersLabel = players.min === players.max
  ? `${players.min} joueurs`
  : `${players.min}-${players.max} joueurs`;

// JSON-LD structured data — Article
const jsonLdArticle = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `Règles de ${title}`,
  description,
  articleSection: 'Règles de jeux de société',
  inLanguage: 'fr',
};

// JSON-LD structured data — BreadcrumbList
const jsonLdBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Accueil',
      item: 'https://regles-jeux.fr/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Jeux',
      item: 'https://regles-jeux.fr/jeux/',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: title,
      item: `https://regles-jeux.fr/jeux/${game.data.slug}/`,
    },
  ],
};
---

<BaseLayout
  title={`Règles de ${title} - Règles du Jeu`}
  description={description}
  ogType="article"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdArticle)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdBreadcrumb)} />
  </Fragment>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- Breadcrumb -->
    <nav class="mb-6 text-sm" aria-label="Fil d'Ariane">
      <ol class="flex items-center gap-2 text-gray-500">
        <li><a href="/" class="hover:text-primary-600 transition-colors">Accueil</a></li>
        <li><span class="text-gray-300">/</span></li>
        <li><a href="/jeux/" class="hover:text-primary-600 transition-colors">Jeux</a></li>
        <li><span class="text-gray-300">/</span></li>
        <li class="text-gray-900 font-medium">{title}</li>
      </ol>
    </nav>

    <!-- Header (full width) -->
    <header class="mb-8 max-w-4xl">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mb-4">{title}</h1>
      <p class="text-lg text-gray-500 mb-6">{description}</p>

      <!-- Game meta -->
      <div class="flex flex-wrap gap-4 p-4 bg-white rounded-xl border border-gray-100">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg bg-primary-50 flex items-center justify-center">
            <svg class="w-4 h-4 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <div>
            <p class="text-xs text-gray-400 leading-none">Joueurs</p>
            <p class="text-sm font-semibold text-gray-900">{playersLabel}</p>
          </div>
        </div>

        <div class="w-px bg-gray-100"></div>

        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg bg-primary-50 flex items-center justify-center">
            <svg class="w-4 h-4 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <p class="text-xs text-gray-400 leading-none">Durée</p>
            <p class="text-sm font-semibold text-gray-900">{duration}</p>
          </div>
        </div>

        <div class="w-px bg-gray-100"></div>

        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg bg-primary-50 flex items-center justify-center">
            <span class="text-primary-600 text-xs font-bold">{age}+</span>
          </div>
          <div>
            <p class="text-xs text-gray-400 leading-none">Âge minimum</p>
            <p class="text-sm font-semibold text-gray-900">{age} ans et plus</p>
          </div>
        </div>

        <div class="w-px bg-gray-100"></div>

        <div class="flex items-center gap-2">
          <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${difficultyColors[difficulty]}`}>
            {difficultyLabels[difficulty]}
          </span>
        </div>
      </div>

      <!-- Categories -->
      <div class="flex flex-wrap gap-2 mt-4">
        {categories.map((cat: string) => (
          <a
            href={`/categories/${cat}/`}
            class="badge-category hover:bg-primary-100 transition-colors"
          >
            {cat}
          </a>
        ))}
      </div>

      <!-- Game master CTA for Loup-Garou -->
      {game.data.slug === 'loup-garou' && (
        <div class="mt-6 flex justify-center sm:justify-start">
          <a
            href="/jeux/loup-garou/partie/"
            class="btn-primary inline-flex items-center gap-2"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Jouer une partie
          </a>
        </div>
      )}
    </header>

    <!-- Two-column layout on desktop -->
    <div class="lg:flex lg:gap-10">
      <!-- Sticky sidebar TOC (desktop) + mobile TOC + floating button all in one component -->
      <TableOfContents headings={headings} />

      <!-- Main content column -->
      <article class="min-w-0 max-w-4xl flex-1">
        <!-- Rule content -->
        <div class="prose prose-lg max-w-none prose-headings:text-gray-900 prose-headings:font-bold prose-p:text-gray-600 prose-p:leading-relaxed prose-li:text-gray-600 prose-strong:text-gray-800 prose-table:text-sm prose-th:bg-gray-50 prose-th:font-semibold prose-td:border-gray-200 prose-a:text-primary-600 prose-a:no-underline hover:prose-a:underline">
          <Content />
        </div>

        <!-- Official rules link -->
        {officialRulesUrl && (
          <div class="mt-10 p-5 bg-primary-50 rounded-xl border border-primary-100">
            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-lg bg-primary-100 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 mb-1">Règles officielles</h3>
                <p class="text-sm text-gray-600 mb-2">
                  Pour les règles complètes et officielles de l'éditeur :
                </p>
                <a
                  href={officialRulesUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-sm font-medium text-primary-600 hover:text-primary-700 transition-colors"
                >
                  Consulter les règles officielles
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        )}

        <!-- Legal note -->
        <div class="mt-8 p-4 bg-gray-50 rounded-lg text-xs text-gray-400 leading-relaxed">
          <strong class="text-gray-500">Note :</strong> Les règles présentées sur cette page sont un résumé original
          rédigé dans un but informatif. Pour les règles officielles complètes, veuillez consulter l'éditeur du jeu.
        </div>

        <!-- Back link -->
        <div class="mt-8">
          <a href="/jeux/" class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-primary-600 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Retour à la liste des jeux
          </a>
        </div>
      </article>
    </div>
  </div>
</BaseLayout>
