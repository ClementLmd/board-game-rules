---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import CompetitionForm from '../../components/competitions/CompetitionForm';

if (!Astro.locals.user) {
  return Astro.redirect('/auth/login?next=/competitions/create/');
}

const user = Astro.locals.user;
---

<BaseLayout title="Créer une compétition – Règles du Jeu" darkHeader darkFooter>
  <div class="min-h-screen bg-gray-950 text-gray-100 py-12 px-4">
    <div class="max-w-xl mx-auto">
      <div class="mb-8">
        <a href="/competitions/" class="text-gray-400 hover:text-white text-sm flex items-center gap-1 mb-4 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Retour aux compétitions
        </a>
        <h1 class="text-3xl font-bold text-white">Créer une compétition</h1>
        <p class="text-gray-400 mt-2">Vous serez l'administrateur de cette compétition et pourrez planifier des journées de jeu et valider les résultats.</p>
      </div>

      <div class="bg-gray-900 rounded-2xl border border-gray-800 p-8">
        <CompetitionForm client:load userId={user.id} />
      </div>
    </div>
  </div>
</BaseLayout>
