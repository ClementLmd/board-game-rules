---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import MyCompetitions from '../../components/competitions/MyCompetitions';

const user = Astro.locals.user;
const supabase = Astro.locals.supabase;

// Pre-fill code from ?code= query param (shared link)
const prefillCode = Astro.url.searchParams.get('code') ?? '';

// Competitions where user is admin
let adminCompetitions: { id: string; name: string; status: string; invite_code: string | null; member_count: number }[] = [];
// Competitions where user is a member
let memberCompetitions: { id: string; name: string; status: string; member_status: string; total_points: number }[] = [];

if (user && supabase) {
  const [adminRes, memberRes] = await Promise.all([
    supabase
      .from('competitions')
      .select('id, name, status, invite_code, competition_members(count)')
      .eq('admin_id', user.id)
      .order('created_at', { ascending: false }),
    supabase
      .from('competition_members')
      .select('status, total_points, competitions(id, name, status)')
      .eq('user_id', user.id)
      .order('joined_at', { ascending: false }),
  ]);

  adminCompetitions = (adminRes.data ?? []).map((c) => ({
    id: c.id,
    name: c.name,
    status: c.status,
    invite_code: c.invite_code,
    member_count: (c.competition_members as unknown as { count: number }[])[0]?.count ?? 0,
  }));

  memberCompetitions = (memberRes.data ?? [])
    .filter((m) => {
      const comp = m.competitions as { id: string } | null;
      return comp && !adminCompetitions.find((a) => a.id === comp.id);
    })
    .map((m) => {
      const comp = m.competitions as { id: string; name: string; status: string };
      return {
        id: comp.id,
        name: comp.name,
        status: comp.status,
        member_status: m.status,
        total_points: m.total_points,
      };
    });
}
---

<BaseLayout title="Compétitions – Règles du Jeu" description="Gérez vos compétitions et rejoignez-en de nouvelles." darkHeader darkFooter>
  <div class="min-h-screen bg-gray-950 text-gray-100">
    <!-- Hero -->
    <div class="bg-gradient-to-b from-gray-900 to-gray-950 border-b border-gray-800 py-12 px-4">
      <div class="max-w-4xl mx-auto">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div>
            <h1 class="text-3xl font-bold text-white mb-2">Compétitions</h1>
            <p class="text-gray-400">Rejoignez une compétition avec un code ou créez la vôtre.</p>
          </div>
          {user ? (
            <a
              href="/competitions/create/"
              class="mx-auto sm:mx-0 flex items-center gap-2 px-5 py-2.5 bg-violet-600 text-white rounded-xl font-medium hover:bg-violet-700 transition-colors text-sm"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
              Créer une compétition
            </a>
          ) : (
            <a
              href="/auth/login?next=/competitions/"
              class="px-5 py-2.5 bg-violet-600 text-white rounded-xl font-medium hover:bg-violet-700 transition-colors text-sm"
            >
              Connexion pour participer
            </a>
          )}
        </div>
      </div>
    </div>

    <div class="max-w-4xl mx-auto px-4 py-10">
      {!user ? (
        <div class="text-center py-16">
          <div class="text-6xl mb-4">🏆</div>
          <p class="text-gray-400 mb-6">Connectez-vous pour rejoindre ou créer des compétitions.</p>
          <a href="/auth/login?next=/competitions/" class="px-6 py-3 bg-violet-600 text-white rounded-xl font-medium hover:bg-violet-700 transition-colors">
            Se connecter
          </a>
        </div>
      ) : (
        <MyCompetitions
          client:load
          userId={user.id}
          adminCompetitions={adminCompetitions}
          memberCompetitions={memberCompetitions}
          prefillCode={prefillCode}
        />
      )}
    </div>
  </div>
</BaseLayout>
