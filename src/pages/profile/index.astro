---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import NotificationList from '../../components/competitions/NotificationList';

if (!Astro.locals.user) {
  return Astro.redirect('/auth/login?next=/profile/');
}

const user = Astro.locals.user;
const supabase = Astro.locals.supabase;

const { data: profile } = await supabase
  .from('profiles')
  .select('*')
  .eq('id', user.id)
  .single();

const { data: adminCompetitions } = await supabase
  .from('competitions')
  .select('id, name, status, created_at')
  .eq('admin_id', user.id)
  .order('created_at', { ascending: false });

const { data: memberCompetitions } = await supabase
  .from('competition_members')
  .select('status, total_points, competitions(id, name, status)')
  .eq('user_id', user.id)
  .neq('status', 'rejected')
  .order('joined_at', { ascending: false });

let saveSuccess = false;
let saveError: string | null = null;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const username = (formData.get('username') as string)?.trim();

  if (username) {
    const { error } = await supabase
      .from('profiles')
      .update({ username })
      .eq('id', user.id);

    if (error) {
      saveError = error.message;
    } else {
      saveSuccess = true;
    }
  }
}
---

<BaseLayout title="Mon profil – Règles du Jeu" darkHeader darkFooter>
  <div class="min-h-screen bg-gray-950 text-gray-100 py-10 px-4">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-3xl font-bold text-white mb-8">Mon profil</h1>

      <div class="grid md:grid-cols-3 gap-6">
        <!-- Profile card -->
        <div class="md:col-span-1">
          <div class="bg-gray-900 rounded-2xl border border-gray-800 p-6">
            <div class="flex flex-col items-center text-center mb-6">
              {profile?.avatar_url ? (
                <img
                  src={profile.avatar_url}
                  alt="Avatar"
                  class="w-20 h-20 rounded-full object-cover mb-3"
                />
              ) : (
                <div class="w-20 h-20 rounded-full bg-violet-700 flex items-center justify-center text-white text-2xl font-bold mb-3">
                  {(profile?.username ?? user.email ?? '?').slice(0, 2).toUpperCase()}
                </div>
              )}
              <p class="font-semibold text-white text-lg">{profile?.username ?? 'Joueur'}</p>
              <p class="text-gray-400 text-sm">{user.email}</p>
            </div>

            {saveSuccess && (
              <div class="mb-4 p-3 bg-green-900/40 border border-green-700 rounded-lg text-green-400 text-sm text-center">
                Profil mis à jour !
              </div>
            )}
            {saveError && (
              <div class="mb-4 p-3 bg-red-900/40 border border-red-700 rounded-lg text-red-400 text-sm text-center">
                {saveError}
              </div>
            )}

            <form method="POST" class="space-y-3">
              <div>
                <label class="block text-xs font-medium text-gray-400 mb-1">Pseudo</label>
                <input
                  type="text"
                  name="username"
                  value={profile?.username ?? ''}
                  class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-sm text-white focus:outline-none focus:ring-2 focus:ring-violet-500"
                  placeholder="Votre pseudo"
                />
              </div>
              <button
                type="submit"
                class="w-full px-4 py-2 bg-violet-600 text-white rounded-lg text-sm font-medium hover:bg-violet-700 transition-colors"
              >
                Sauvegarder
              </button>
            </form>
          </div>
        </div>

        <!-- Competitions & Notifications -->
        <div class="md:col-span-2 space-y-6">
          <!-- My Competitions -->
          <div class="bg-gray-900 rounded-2xl border border-gray-800 p-6">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-lg font-semibold text-white">Mes compétitions</h2>
              <a href="/competitions/create/" class="text-sm text-violet-400 hover:text-violet-300">+ Créer</a>
            </div>

            {adminCompetitions && adminCompetitions.length > 0 && (
              <div class="mb-4">
                <p class="text-xs font-medium text-gray-400 uppercase tracking-wider mb-2">En tant qu'admin</p>
                <div class="space-y-2">
                  {adminCompetitions.map((c) => (
                    <a
                      href={`/competitions/${c.id}/`}
                      class="flex items-center justify-between p-3 bg-gray-800 rounded-xl hover:bg-gray-750 transition-colors"
                    >
                      <span class="text-sm font-medium text-white">{c.name}</span>
                      <span class:list={[
                        'text-xs px-2 py-0.5 rounded-full font-medium',
                        c.status === 'active' ? 'bg-green-900/50 text-green-400' : 'bg-gray-700 text-gray-400'
                      ]}>
                        {c.status === 'active' ? 'Active' : c.status === 'draft' ? 'Brouillon' : 'Terminée'}
                      </span>
                    </a>
                  ))}
                </div>
              </div>
            )}

            {memberCompetitions && memberCompetitions.length > 0 && (
              <div>
                <p class="text-xs font-medium text-gray-400 uppercase tracking-wider mb-2">En tant que joueur</p>
                <div class="space-y-2">
                  {memberCompetitions.map((m) => {
                    const comp = m.competitions as { id: string; name: string; status: string } | null;
                    if (!comp) return null;
                    return (
                      <a
                        href={`/competitions/${comp.id}/`}
                        class="flex items-center justify-between p-3 bg-gray-800 rounded-xl hover:bg-gray-750 transition-colors"
                      >
                        <span class="text-sm font-medium text-white">{comp.name}</span>
                        <div class="flex items-center gap-2">
                          <span class="text-sm font-bold text-violet-400">{m.total_points} pts</span>
                          {m.status === 'pending' && (
                            <span class="text-xs px-2 py-0.5 rounded-full bg-yellow-900/50 text-yellow-400">En attente</span>
                          )}
                        </div>
                      </a>
                    );
                  })}
                </div>
              </div>
            )}

            {(!adminCompetitions || adminCompetitions.length === 0) && (!memberCompetitions || memberCompetitions.length === 0) && (
              <p class="text-gray-400 text-sm text-center py-4">
                Vous ne participez à aucune compétition.{' '}
                <a href="/competitions/" class="text-violet-400 hover:underline">Découvrir les compétitions</a>
              </p>
            )}
          </div>

          <!-- Notifications -->
          <div class="bg-gray-900 rounded-2xl border border-gray-800 p-6">
            <h2 class="text-lg font-semibold text-white mb-4">Notifications</h2>
            <NotificationList client:load userId={user.id} />
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
