---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import LoginForm from '../../components/competitions/LoginForm';

if (Astro.locals.user) {
  return Astro.redirect('/competitions/');
}

const redirectTo = Astro.url.searchParams.get('next') ?? '/competitions/';
const authError = Astro.url.searchParams.get('error');
---

<BaseLayout title="Connexion – Règles du Jeu" description="Connectez-vous pour participer aux compétitions.">
  <div class="min-h-screen bg-gradient-to-br from-violet-50 via-white to-purple-50 flex items-center justify-center px-4 py-16">
    <div class="w-full max-w-md">
      {authError && (
        <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-xl text-red-700 text-sm text-center">
          Une erreur est survenue lors de la connexion. Réessayez.
        </div>
      )}
      <LoginForm client:load redirectTo={redirectTo} />
    </div>
  </div>
</BaseLayout>
