---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameCard from '../../components/GameCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const games = await getCollection('games');
  const allCategories = [...new Set(games.flatMap((game) => game.data.categories))];

  return allCategories.map((category) => ({
    params: { category },
    props: {
      category,
      games: games.filter((game) => game.data.categories.includes(category)),
    },
  }));
}

const { category, games } = Astro.props;
const categoryLabel = category.charAt(0).toUpperCase() + category.slice(1);
---

<BaseLayout
  title={`${categoryLabel} - Règles du Jeu`}
  description={`Retrouvez tous les jeux de société dans la catégorie ${categoryLabel}.`}
>
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- Breadcrumb -->
    <nav class="mb-6 text-sm">
      <ol class="flex items-center gap-2 text-gray-500">
        <li><a href="/" class="hover:text-primary-600 transition-colors">Accueil</a></li>
        <li><span class="text-gray-300">/</span></li>
        <li><a href="/jeux/" class="hover:text-primary-600 transition-colors">Jeux</a></li>
        <li><span class="text-gray-300">/</span></li>
        <li class="text-gray-900 font-medium">{categoryLabel}</li>
      </ol>
    </nav>

    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-2">{categoryLabel}</h1>
      <p class="text-gray-500">
        {games.length} {games.length > 1 ? 'jeux' : 'jeu'} dans cette catégorie
      </p>
    </div>

    <!-- Games grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {games.map((game: any) => (
        <GameCard
          title={game.data.title}
          slug={game.data.slug}
          description={game.data.description}
          players={game.data.players}
          duration={game.data.duration}
          age={game.data.age}
          categories={game.data.categories}
          difficulty={game.data.difficulty}
          image={game.data.image}
        />
      ))}
    </div>

    <!-- Back link -->
    <div class="mt-10">
      <a href="/jeux/" class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-primary-600 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Retour à tous les jeux
      </a>
    </div>
  </section>
</BaseLayout>
